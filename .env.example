# Copy this file to .env and fill in values for your environment.

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave DB_ENGINE unset (or "sqlite") for local dev — uses db.sqlite3 automatically.
# Set DB_ENGINE=postgres and fill the rest to use Postgres (e.g. in Docker/deployed mode).
DB_ENGINE=sqlite
DB_NAME=trade_monitor
DB_USER=trade_monitor
DB_PASSWORD=trade_monitor
DB_HOST=db
DB_PORT=5432
